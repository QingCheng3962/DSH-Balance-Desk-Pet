{
  "name": "dsh-whale-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "dsh-whale-desktop",
  "description": "DSH 小鲸鱼余额桌面挂件（独立 Electron 版）：透明置顶、可点击穿透、Bongo Cat Mver 式悬停",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node scripts/smoke.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsh.whale.desktop",
    "productName": "DSH小鲸鱼桌面挂件",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "host/**/*",
      "shell/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../lib",
        "to": "lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "host/plugin-package.json",
        "to": "lib/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH小鲸鱼挂件"
    }
  }
}
